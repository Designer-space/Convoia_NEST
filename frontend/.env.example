# Origin of the Convoia backend used by the Next.js rewrite in next.config.mjs
# so that /api/* is served from this site's own origin (first-party cookies).
# Server-side only — do not prefix with NEXT_PUBLIC_. No trailing slash.
BACKEND_URL=https://convoia-nest.onrender.com

# What the browser uses for HTTP requests. In production this is the relative
# "/api" path handled by the rewrite above. Required — production builds fail
# without it.
NEXT_PUBLIC_API_BASE_URL=/api

# Absolute backend origin used for WebSockets. Vercel cannot proxy WebSocket
# upgrades, so this must be an absolute URL — production builds fail otherwise.
NEXT_PUBLIC_SOCKET_URL=https://convoia-nest.onrender.com

# Local development: talk to the backend directly instead of through the proxy.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
