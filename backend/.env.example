# --- Core ---
NODE_ENV=development
PORT=3000

# --- Auth ---
# Min 16 chars in development, min 32 in production.
JWT_SECRET=your_secret_here_min_16_chars
# Access token lifetime (short — the refresh cookie keeps sessions alive).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days.
JWT_REFRESH_TTL_DAYS=30
# Optional cookie settings for the HttpOnly refresh token.
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true

# --- Databases ---
# Neon Postgres (pooled URL from `neon connection-string` for runtime app connections)
PGADMIN_URI=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct (unpooled) URL — used by the migration CLI only, not at runtime.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# --- Media ---
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# --- HTTP ---
# Comma-separated browser origins allowed to call the API (credentials enabled).
# Required in production.
CORS_ORIGINS=http://localhost:3000
# Number of proxy hops to trust when resolving the client IP (Render/Cloudflare = 1).
TRUST_PROXY=1
