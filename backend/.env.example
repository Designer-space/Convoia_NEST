JWT_SECRET=your_secret_here_min_32_chars
# Neon Postgres (pooled URL from `neon connection-string` for runtime app connections)
PGADMIN_URI=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct (unpooled) URL — use only for migrations/schema DDL, not runtime
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
PORT=3000
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
NODE_ENV=development
